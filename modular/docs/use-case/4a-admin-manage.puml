@startuml use_case_admin_manage
' Sunrise Dental Clinic - Use Case Diagram: Administrator - reports and accounts
' Source of truth: modular/docs/use-case-diagram.md
!pragma layout smetana
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BackgroundColor #FDF3EC
  BorderColor #C2571A
  ArrowColor #52606D
}

left to right direction
' invisible title: reserves top margin so an actor at the
' upper edge is not clipped by the render bounds
title <color:#FFFFFF>.\n.</color>

actor "Administrator" as AD

rectangle "Sunrise Dental Clinic System" {
  usecase "Sign In" as UC_LOGIN
  usecase "Authenticate\nCredentials" as UC_AUTH
  usecase "View Clinic Reports" as UC_REP
  usecase "Aggregate Bills" as UC_AGG
  usecase "Export CSV" as UC_CSV
  usecase "Create Staff\nAccount" as UC_NEW
  usecase "Validate Account\nDetails" as UC_VACC
  usecase "Assign Sign-In\nUsername" as UC_USER
  usecase "Create Dentist\nProfile" as UC_DENT
  usecase "Unlock Account" as UC_UNLOCK
  usecase "Deactivate Account" as UC_DEACT
  usecase "Configure Pricing" as UC_PRICE
  usecase "Validate Pricing\nValues" as UC_VPRICE
}

AD --> UC_LOGIN
AD --> UC_REP
AD --> UC_NEW
AD --> UC_UNLOCK
AD --> UC_DEACT
AD --> UC_PRICE

UC_LOGIN ..> UC_AUTH  : <<include>>
UC_REP   ..> UC_AGG  : <<include>>
UC_NEW   ..> UC_VACC : <<include>>
UC_NEW   ..> UC_USER : <<include>>
UC_PRICE ..> UC_VPRICE : <<include>>

UC_CSV  ..> UC_REP : <<extend>>
UC_DENT ..> UC_NEW : <<extend>>

note bottom of UC_NEW
  Creates reception, dentist and
  administrator accounts only.
  Every account gets a readable
  number and the staff get a
  username. Unlock and deactivate
  apply to every account,
  patients included.
end note

note bottom of UC_PRICE
  Dentist share percent and
  service charge, live for the
  next bill. Issued bills keep
  the split they went out with.
end note
@enduml
