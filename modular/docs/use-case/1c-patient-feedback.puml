@startuml use_case_patient_feedback
' Sunrise Dental Clinic - Use Case Diagram: Patient - notes, concerns, ratings
' Source of truth: modular/docs/use-case-diagram.md
!pragma layout smetana
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BackgroundColor #FDF3EC
  BorderColor #C2571A
  ArrowColor #52606D
}

left to right direction
' invisible title: reserves top margin so an actor at the
' upper edge is not clipped by the render bounds
title <color:#FFFFFF>.\n.</color>

actor "Patient" as PT

rectangle "Sunrise Dental Clinic System" {
  usecase "Declare Medical\nNotes" as UC_NOTES
  usecase "Mark Note Critical" as UC_CRIT
  usecase "Raise Concern" as UC_CMP
  usecase "Attach Appointment" as UC_ATTACH
  usecase "Rate Visit" as UC_RATE
  usecase "Add Comment" as UC_COMMENT
}

PT --> UC_NOTES
PT --> UC_CMP
PT --> UC_RATE

UC_CRIT    ..> UC_NOTES : <<extend>>
UC_ATTACH  ..> UC_CMP   : <<extend>>
UC_COMMENT ..> UC_RATE  : <<extend>>

note bottom of UC_NOTES
  Collected after sign-in, never
  at registration. Read by the
  treating dentist only.
end note

note bottom of UC_CMP
  Read by the administrator.
  Never by the dentist named.
end note
@enduml
