@startuml use_case_patient_booking
' Sunrise Dental Clinic - Use Case Diagram: Patient - booking
' Source of truth: modular/docs/use-case-diagram.md
!pragma layout smetana
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BackgroundColor #FDF3EC
  BorderColor #C2571A
  ArrowColor #52606D
}

left to right direction
' invisible title: reserves top margin so an actor at the
' upper edge is not clipped by the render bounds
title <color:#FFFFFF>.\n.</color>

actor "Patient" as PT
actor "SMTP Server" as SMTP <<system>>
actor "SMS Gateway" as SMS <<system>>

rectangle "Sunrise Dental Clinic System" {
  usecase "View Dentist\nAvailability" as UC_AVAIL
  usecase "Book Appointment" as UC_BOOK
  usecase "Validate Booking" as UC_VBOOK
  usecase "Reserve Slot" as UC_SLOT
  usecase "Send Confirmation" as UC_CONF
  usecase "Send Reminder" as UC_REMIND
  usecase "View My\nAppointments" as UC_MYAPT
  usecase "Cancel Appointment" as UC_CANCEL
  usecase "Release Slot" as UC_REL
  usecase "View My Bill" as UC_BILL
}

PT --> UC_AVAIL
PT --> UC_BOOK
PT --> UC_MYAPT
PT --> UC_CANCEL
PT --> UC_BILL

UC_CONF   --> SMTP
UC_REMIND --> SMS

UC_BOOK   ..> UC_VBOOK : <<include>>
UC_BOOK   ..> UC_SLOT  : <<include>>
UC_BOOK   ..> UC_CONF  : <<include>>
UC_CANCEL ..> UC_REL   : <<include>>
UC_REMIND ..> UC_BOOK  : <<extend>>
@enduml
