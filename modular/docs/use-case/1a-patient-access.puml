@startuml use_case_patient_access
' Sunrise Dental Clinic - Use Case Diagram: Patient - access
' Source of truth: modular/docs/use-case-diagram.md
!pragma layout smetana
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam nodesep 18
skinparam ranksep 70
skinparam usecase {
  BackgroundColor #FDF3EC
  BorderColor #C2571A
  ArrowColor #52606D
}

left to right direction
' invisible title: reserves top margin so an actor at the
' upper edge is not clipped by the render bounds
title <color:#FFFFFF>.\n.</color>

actor "Patient" as PT

rectangle "Sunrise Dental Clinic System" {
  usecase "Register Account" as UC_REG
  usecase "Validate\nRegistration" as UC_VREG
  usecase "Sign In" as UC_LOGIN
  usecase "Authenticate\nCredentials" as UC_AUTH
  usecase "Lock Account After\nFive Failures" as UC_LOCK
  usecase "Sign Out" as UC_OUT
  usecase "View Help" as UC_HELP
}

PT --> UC_REG
PT --> UC_LOGIN
PT --> UC_OUT
PT --> UC_HELP

UC_REG   ..> UC_VREG : <<include>>
UC_LOGIN ..> UC_AUTH : <<include>>
UC_LOCK  ..> UC_LOGIN : <<extend>>

note bottom of UC_REG
  Patients only. Reception, dentist
  and administrator accounts are
  created by the administrator.
end note
@enduml
