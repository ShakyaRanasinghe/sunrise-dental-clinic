@startuml seq_sign_in
' Sunrise Dental Clinic - Sequence: Sign In through a role portal
' Source of truth: modular/docs/sequence-diagrams.md
!pragma layout smetana
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 12
skinparam BoxPadding 12
skinparam sequence {
  ArrowColor #52606D
  LifeLineBorderColor #C2571A
  LifeLineBackgroundColor #FDF3EC
  ParticipantBorderColor #C2571A
  ParticipantBackgroundColor #FDF3EC
  ActorBorderColor #52606D
}

actor "Receptionist" as U

box "Presentation tier" #FBFCFD
  participant "ReceptionLoginServlet\n: AbstractLoginServlet" as SV
  participant "AuthenticationFilter" as F
end box
box "Business tier" #FFFFFF
  participant "authService\n: AuthService" as AS
  participant "attempts\n: LoginAttemptService" as LA
  participant "hasher\n: PasswordHasher" as PH
  participant "policy\n: ReceptionPolicy" as PL
end box
box "Data tier" #FBFCFD
  participant "users\n: UserRepository" as UR
  database "MySQL" as DB
end box

U -> SV : POST /login/reception\n(username-or-email, password)
activate SV

SV -> AS : login(identifier, password)
activate AS

AS -> LA : isLocked(identifier)
activate LA
LA --> AS : false
deactivate LA

AS -> UR : findByUsername(identifier)\nthen findByEmail(identifier)
activate UR
UR -> DB : SELECT ... FROM user_account\nWHERE username = ? OR email = ?
DB --> UR : row
UR --> AS : Optional<UserAccount>
deactivate UR
note right of UR
  Usernames hold no @, so an address
  goes straight to the email lookup.
  Patients hold no username, so the
  patient portal behaves exactly
  as before.
end note

AS -> PH : matches(password, storedHash)
activate PH
note right of PH
  PBKDF2, 120,000 iterations,
  per-user salt, constant-time
  compare  (NFR-SEC-01, -02)
end note
PH --> AS : true
deactivate PH

AS -> LA : recordSuccess(identifier)
AS --> SV : LoginResult(success, account)
deactivate AS

alt account.role == acceptedRole()
  SV -> PL : homePath()
  activate PL
  PL --> SV : "/reception/home"
  deactivate PL
  SV -> F : establishSession(request, principal)
  activate F
  F --> SV : session created
  deactivate F
  SV --> U : 302 -> /reception/home
else role does not match this portal
  note over SV
    Re-render with the **same** generic
    message and comparable timing, so a
    portal cannot be used to discover
    which role an identity belongs to
    (FR-AUTH-03)
  end note
  SV --> U : 200 login-reception.jsp\n"Incorrect username or password."
end

deactivate SV

@enduml
