@startuml seq_book_appointment
' Sunrise Dental Clinic - Sequence: Book Appointment (with the concurrency guard)
' Source of truth: modular/docs/sequence-diagrams.md
!pragma layout smetana
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam ParticipantPadding 12
skinparam BoxPadding 12
skinparam sequence {
  ArrowColor #52606D
  LifeLineBorderColor #C2571A
  LifeLineBackgroundColor #FDF3EC
  ParticipantBorderColor #C2571A
  ParticipantBackgroundColor #FDF3EC
  ActorBorderColor #52606D
}

actor "Patient" as U

box "Presentation tier" #FBFCFD
  participant "BookAppointmentServlet" as SV
end box
box "Business tier" #FFFFFF
  participant "service\n: AppointmentService" as AS
  participant "tx\n: TransactionRunner" as TX
  participant "numbers\n: AppointmentNumberGenerator" as NG
  participant "publisher\n: AppointmentEventPublisher" as EP
  participant "obs\n: NotificationObserver" as OB
end box
box "Data tier" #FBFCFD
  participant "slots\n: SlotRepository" as SR
  participant "appts\n: AppointmentRepository" as AR
  database "MySQL" as DB
end box

U -> SV : POST /patient/book\n(slotId, treatmentId?, patientReason?)
activate SV

SV -> AS : book(patientId, slotId,\ntreatmentId, actor)
activate AS
note right of AS
  An "Other" booking sends no
  treatmentId: the free-text reason
  is stored on the appointment and
  the dentist prices it at completion
  (GAP-DEN-13), not here.
end note

AS -> TX : inTransaction( ... )
activate TX
TX -> DB : BEGIN

TX -> SR : lockForUpdate(slotId)
activate SR
SR -> DB : SELECT ... FROM slot\nWHERE id = ? FOR UPDATE
note right of DB
  The row lock is what makes
  FR-APT-04 true under concurrency,
  not merely in sequence
end note
DB --> SR : slot row (locked)
SR --> TX : Slot
deactivate SR

alt slot.isOpen()
  TX -> NG : nextFor(date)
  activate NG
  NG -> DB : UPDATE appointment_counter\nSET counter_value = counter_value + 1
  DB --> NG : 4
  NG --> TX : "APT-20260901-0004"
  deactivate NG

  TX -> AR : save(appointment)
  activate AR
  AR -> DB : INSERT INTO appointment ...
  AR --> TX : Appointment
  deactivate AR

  TX -> SR : save(slot.bookFor(no))
  activate SR
  SR -> DB : UPDATE slot SET status = 'BOOKED',\nappointment_no = ?
  note right of DB
    UNIQUE (slot.appointment_no)
    is the database-level backstop
  end note
  SR --> TX : Slot
  deactivate SR

  TX -> DB : COMMIT
  TX --> AS : Appointment
  deactivate TX

  AS -> EP : publish(BOOKED, appointment)
  activate EP
  EP -> OB : onAppointmentEvent(event)
  activate OB
  note right of OB
    Delivery failure is recorded and
    never fails the booking (FR-NOT-04)
  end note
  OB --> EP : recorded
  deactivate OB
  EP --> AS : done
  deactivate EP

  AS --> SV : Appointment
  SV --> U : 200 - appointment number shown

else slot already BOOKED
  TX -> DB : ROLLBACK
  TX --> AS : SlotUnavailableException
  deactivate TX
  AS --> SV : SlotUnavailableException
  note over SV
    Nothing written: no appointment,
    no consumed slot, no counter
    increment  (NFR-REL-01)
  end note
  SV --> U : 409 - "That time has just been\ntaken. Please choose another."
end

deactivate AS
deactivate SV

@enduml
