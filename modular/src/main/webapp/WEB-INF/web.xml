<?xml version="1.0" encoding="UTF-8"?>
<!--
    Deployment descriptor for the Sunrise Dental Clinic system.

    Every servlet, filter and listener is declared here rather than discovered
    from annotations (FR-WEB-01). For a project whose point is to show the
    structure of the application, one file listing every URL the system answers
    is easier to read and to review than the same information scattered across
    thirty classes.

    Generated from docs/servlets.md — 39 servlets, 42 mappings, 1 filter.
    That document is the contract; if the two disagree, it is right and this is
    stale.

    NOTE: this declares what EXISTS, not the whole target. docs/servlets.md is the
    contract and lists all 32 servlets; each migration step adds its own here as
    its classes land. Declaring a servlet whose class is missing would let Tomcat
    start and then answer 500 with a ClassNotFoundException on first request,
    which is a worse failure than a clean 404.

    After step 7: access, patients, scheduling, appointments, billing and reporting are
    migrated. No temporary stubs remain — every role lands on a real screen. Four temporary stub
    mappings still stand in for the role landing pages.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Sunrise Dental Clinic</display-name>

    <!--
        Formatting locale.

        JSTL picks the locale for <fmt:formatNumber> from the browser's
        Accept-Language header, and when it cannot match one it silently falls
        back to Double.toString() — so a bill total renders as "5200.0" instead
        of "5,200.00" for any client that omits the header.
    -->
    <context-param>
        <param-name>jakarta.servlet.jsp.jstl.fmt.fallbackLocale</param-name>
        <param-value>en_GB</param-value>
    </context-param>

    <!--
        JSP sources are UTF-8. Without this the container falls back to
        ISO-8859-1 and any non-ASCII character in a page - an em dash, a
        patient name with an accent - renders as mojibake.
    -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <default-content-type>text/html</default-content-type>
            <!-- Directives and JSP comments each leave their trailing newline in
                 the response. Nine of them preceded <!doctype html>, which has to
                 be the first thing the browser sees or the page renders in quirks
                 mode. This strips them for every page at once. -->
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

    <!-- Builds the object graph at start-up and closes the pool at shutdown. -->
    <listener>
        <listener-class>com.sunrise.clinic.platform.di.ClinicServletContext</listener-class>
    </listener>

    <!-- Identifies the caller and turns anonymous requests away. -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.sunrise.clinic.access.web.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================================ -->
    <!--  platform — shared                                           -->
    <!-- ============================================================ -->

    <!--
        GAP-FTB-12: one servlet, two mappings. /help is the shared public page;
        /help/* serves the per-role pages (/help/patient, /help/reception,
        /help/dentist, /help/admin) from the same servlet, which picks the view
        from the path. All stay public via the /help filter prefix so a sign-in
        screen can link to its own help.
    -->
    <servlet>
        <servlet-name>Help</servlet-name>
        <servlet-class>com.sunrise.clinic.platform.web.HelpServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Help</servlet-name>
        <url-pattern>/help</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Help</servlet-name>
        <url-pattern>/help/*</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  access — identity, the four portals                         -->
    <!-- ============================================================ -->

    <!--
        FR-WEB-02. The empty pattern matches the context root exactly.
        Mapping this to "/" would replace Tomcat's default servlet, and every
        request for a stylesheet would be answered with a redirect to the
        sign-in page rather than the file.
    -->
    <servlet>
        <servlet-name>Home</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Home</servlet-name>
        <url-pattern></url-pattern>
    </servlet-mapping>

    <!--
        The central staff portal. Lists the three staff roles and sends each to its
        own login; the patient door stays on the public home page.
    -->
    <servlet>
        <servlet-name>StaffPortal</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.StaffPortalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffPortal</servlet-name>
        <url-pattern>/staff</url-pattern>
    </servlet-mapping>

    <!--
        Four portals, four subclasses of AbstractLoginServlet. The superclass
        holds the whole authentication sequence; each subclass supplies only the
        role it admits and the view it renders (FR-OOP-11). There is no bare
        {@code /login} chooser: it was removed because it only offered the patient
        door, and a visitor who has business with the clinic is either a patient
        (who arrives via the public home page) or staff (who are issued their own
        portal address).
    -->
    <servlet>
        <servlet-name>PatientLogin</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.PatientLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientLogin</servlet-name>
        <url-pattern>/login/patient</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReceptionLogin</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.ReceptionLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceptionLogin</servlet-name>
        <url-pattern>/login/reception</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DentistLogin</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.DentistLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DentistLogin</servlet-name>
        <url-pattern>/login/dentist</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminLogin</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLogin</servlet-name>
        <url-pattern>/login/admin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Register</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Register</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Logout</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Logout</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  patients                                                    -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>PatientRecords</servlet-name>
        <servlet-class>com.sunrise.clinic.patients.web.PatientRecordsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientRecords</servlet-name>
        <url-pattern>/reception/patients</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  scheduling                                                  -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>AvailabilityPage</servlet-name>
        <servlet-class>com.sunrise.clinic.scheduling.web.AvailabilityPageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AvailabilityPage</servlet-name>
        <url-pattern>/reception/availability</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>WalkIn</servlet-name>
        <servlet-class>com.sunrise.clinic.scheduling.web.WalkInServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WalkIn</servlet-name>
        <url-pattern>/reception/walkin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DentistReference</servlet-name>
        <servlet-class>com.sunrise.clinic.scheduling.web.DentistReferenceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DentistReference</servlet-name>
        <url-pattern>/reception/dentists</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AppointmentSlip</servlet-name>
        <servlet-class>com.sunrise.clinic.appointments.web.AppointmentSlipServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppointmentSlip</servlet-name>
        <url-pattern>/reception/slip</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  appointments                                                -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>PatientHome</servlet-name>
        <servlet-class>com.sunrise.clinic.appointments.web.PatientHomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientHome</servlet-name>
        <url-pattern>/patient/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookAppointment</servlet-name>
        <servlet-class>com.sunrise.clinic.appointments.web.BookAppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookAppointment</servlet-name>
        <url-pattern>/patient/book</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReceptionDay</servlet-name>
        <servlet-class>com.sunrise.clinic.appointments.web.ReceptionDayServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceptionDay</servlet-name>
        <url-pattern>/reception/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DentistSchedule</servlet-name>
        <servlet-class>com.sunrise.clinic.appointments.web.DentistScheduleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DentistSchedule</servlet-name>
        <url-pattern>/dentist/schedule</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DentistAvailability</servlet-name>
        <servlet-class>com.sunrise.clinic.appointments.web.DentistAvailabilityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DentistAvailability</servlet-name>
        <url-pattern>/dentist/availability</url-pattern>
    </servlet-mapping>

    <!--
        GAP-DEN-14: the dentist's own profile — name, specialisation and phone as
        the public cards show them, editable from the dashboard.
    -->
    <servlet>
        <servlet-name>DentistProfile</servlet-name>
        <servlet-class>com.sunrise.clinic.scheduling.web.DentistProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DentistProfile</servlet-name>
        <url-pattern>/dentist/profile</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  billing                                                     -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>Billing</servlet-name>
        <servlet-class>com.sunrise.clinic.billing.web.BillingPageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Billing</servlet-name>
        <url-pattern>/reception/billing</url-pattern>
    </servlet-mapping>

    <!--
        The printable receipt. Reached by the front desk and by the patient, so it is
        mapped under both role prefixes - the same servlet, and BillingService decides
        who may read the bill behind it.
    -->
    <servlet>
        <servlet-name>Receipt</servlet-name>
        <servlet-class>com.sunrise.clinic.billing.web.ReceiptServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Receipt</servlet-name>
        <url-pattern>/reception/receipt</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Receipt</servlet-name>
        <url-pattern>/patient/receipt</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  reporting                                                   -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>AdminReports</servlet-name>
        <servlet-class>com.sunrise.clinic.reporting.web.AdminReportsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminReports</servlet-name>
        <url-pattern>/admin/reports</url-pattern>
    </servlet-mapping>

    <!--
        An exact mapping, not *.csv. An extension mapping would claim every .csv path in
        the application, and this is one report.
    -->
    <servlet>
        <servlet-name>CsvExport</servlet-name>
        <servlet-class>com.sunrise.clinic.reporting.web.CsvExportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CsvExport</servlet-name>
        <url-pattern>/admin/reports.csv</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Accounts</servlet-name>
        <servlet-class>com.sunrise.clinic.reporting.web.AccountsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Accounts</servlet-name>
        <url-pattern>/admin/accounts</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TreatmentAdmin</servlet-name>
        <servlet-class>com.sunrise.clinic.reporting.web.TreatmentAdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TreatmentAdmin</servlet-name>
        <url-pattern>/admin/treatments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ClinicIdentity</servlet-name>
        <servlet-class>com.sunrise.clinic.reporting.web.ClinicIdentityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClinicIdentity</servlet-name>
        <url-pattern>/admin/clinic</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuditTrail</servlet-name>
        <servlet-class>com.sunrise.clinic.reporting.web.AuditTrailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuditTrail</servlet-name>
        <url-pattern>/admin/audit</url-pattern>
    </servlet-mapping>

    <!--
        GAP-ADM-10: pricing — the dentist's treatment-share percentage and the
        flat service charge, editable at runtime and read live on every bill.
    -->
    <servlet>
        <servlet-name>Pricing</servlet-name>
        <servlet-class>com.sunrise.clinic.reporting.web.PricingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Pricing</servlet-name>
        <url-pattern>/admin/pricing</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  feedback — complaints and reviews                           -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>PatientComplaints</servlet-name>
        <servlet-class>com.sunrise.clinic.feedback.web.PatientComplaintsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientComplaints</servlet-name>
        <url-pattern>/patient/complaints</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminComplaints</servlet-name>
        <servlet-class>com.sunrise.clinic.feedback.web.AdminComplaintsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminComplaints</servlet-name>
        <url-pattern>/admin/complaints</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ComplaintApi</servlet-name>
        <servlet-class>com.sunrise.clinic.feedback.web.ComplaintApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComplaintApi</servlet-name>
        <url-pattern>/api/complaints/*</url-pattern>
    </servlet-mapping>

    <!--
        /api/reviews/* rather than /api/appointments/{no}/review: servlet mapping has no
        middle wildcard, and /api/appointments/* is already claimed. See docs/servlets.md §5.
    -->
    <servlet>
        <servlet-name>ReviewApi</servlet-name>
        <servlet-class>com.sunrise.clinic.feedback.web.ReviewApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewApi</servlet-name>
        <url-pattern>/api/reviews/*</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  JSON API                                                    -->
    <!--                                                              -->
    <!--  A prefix mapping /x/* claims every path beneath it, and      -->
    <!--  servlet mapping has no middle wildcard. That is why a review -->
    <!--  is /api/reviews/* rather than /api/appointments/*/review —   -->
    <!--  see docs/servlets.md §5.                                    -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>AuthApi</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.AuthApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthApi</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PatientProfile</servlet-name>
        <servlet-class>com.sunrise.clinic.patients.web.PatientProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientProfile</servlet-name>
        <url-pattern>/patient/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DentistAppointment</servlet-name>
        <servlet-class>com.sunrise.clinic.appointments.web.DentistAppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DentistAppointment</servlet-name>
        <url-pattern>/dentist/appointment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PatientApi</servlet-name>
        <servlet-class>com.sunrise.clinic.patients.web.PatientApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientApi</servlet-name>
        <url-pattern>/api/patients/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AppointmentApi</servlet-name>
        <servlet-class>com.sunrise.clinic.appointments.web.AppointmentApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppointmentApi</servlet-name>
        <url-pattern>/api/appointments/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AvailabilityApi</servlet-name>
        <servlet-class>com.sunrise.clinic.scheduling.web.AvailabilityApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AvailabilityApi</servlet-name>
        <url-pattern>/api/availability/*</url-pattern>
    </servlet-mapping>
    <!-- Publishing a window and reading its slots are one feature, so one servlet. -->
    <servlet-mapping>
        <servlet-name>AvailabilityApi</servlet-name>
        <url-pattern>/api/sessions</url-pattern>
    </servlet-mapping>

    <!-- One servlet, two exact mappings: the same kind of small readable list. -->
    <servlet>
        <servlet-name>ReferenceApi</servlet-name>
        <servlet-class>com.sunrise.clinic.scheduling.web.ReferenceApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReferenceApi</servlet-name>
        <url-pattern>/api/dentists</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReferenceApi</servlet-name>
        <url-pattern>/api/treatments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AccountApi</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.AccountApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountApi</servlet-name>
        <url-pattern>/api/accounts</url-pattern>
    </servlet-mapping>


    <!-- ============================================================ -->
    <!--  Sessions and error pages                                    -->
    <!-- ============================================================ -->

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <!-- Not readable from JavaScript, which limits what a scripting
                 flaw could do with it (NFR-SEC-04). -->
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/shared/not-found.jsp</location>
    </error-page>
    <!-- Signed in, but the page belongs to another role. The filter forwards
         here directly; this mapping catches a servlet that sets 403 itself. -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/shared/forbidden.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/shared/error.jsp</location>
    </error-page>

</web-app>
