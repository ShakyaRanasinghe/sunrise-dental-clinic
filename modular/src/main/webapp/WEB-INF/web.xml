<?xml version="1.0" encoding="UTF-8"?>
<!--
    Deployment descriptor for the Sunrise Dental Clinic system.

    Every servlet, filter and listener is declared here rather than discovered
    from annotations (FR-WEB-01). For a project whose point is to show the
    structure of the application, one file listing every URL the system answers
    is easier to read and to review than the same information scattered across
    thirty classes.

    Generated from docs/servlets.md — 33 servlets, 36 mappings, 1 filter.
    That document is the contract; if the two disagree, it is right and this is
    stale.

    NOTE: this declares what EXISTS, not the whole target. docs/servlets.md is the
    contract and lists all 32 servlets; each migration step adds its own here as
    its classes land. Declaring a servlet whose class is missing would let Tomcat
    start and then answer 500 with a ClassNotFoundException on first request,
    which is a worse failure than a clean 404.

    After step 3b: access, the patient register and scheduling are migrated. Four temporary stub
    mappings still stand in for the role landing pages.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Sunrise Dental Clinic</display-name>

    <!--
        Formatting locale.

        JSTL picks the locale for <fmt:formatNumber> from the browser's
        Accept-Language header, and when it cannot match one it silently falls
        back to Double.toString() — so a bill total renders as "5200.0" instead
        of "5,200.00" for any client that omits the header.
    -->
    <context-param>
        <param-name>jakarta.servlet.jsp.jstl.fmt.fallbackLocale</param-name>
        <param-value>en_GB</param-value>
    </context-param>

    <!--
        JSP sources are UTF-8. Without this the container falls back to
        ISO-8859-1 and any non-ASCII character in a page - an em dash, a
        patient name with an accent - renders as mojibake.
    -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <default-content-type>text/html</default-content-type>
            <!-- Directives and JSP comments each leave their trailing newline in
                 the response. Nine of them preceded <!doctype html>, which has to
                 be the first thing the browser sees or the page renders in quirks
                 mode. This strips them for every page at once. -->
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

    <!-- Builds the object graph at start-up and closes the pool at shutdown. -->
    <listener>
        <listener-class>com.sunrise.clinic.platform.di.ClinicServletContext</listener-class>
    </listener>

    <!-- Identifies the caller and turns anonymous requests away. -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.sunrise.clinic.access.web.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================================ -->
    <!--  platform — shared                                           -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>Help</servlet-name>
        <servlet-class>com.sunrise.clinic.platform.web.HelpServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Help</servlet-name>
        <url-pattern>/help</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  access — identity, the four portals                         -->
    <!-- ============================================================ -->

    <!--
        FR-WEB-02. The empty pattern matches the context root exactly.
        Mapping this to "/" would replace Tomcat's default servlet, and every
        request for a stylesheet would be answered with a redirect to the
        sign-in page rather than the file.
    -->
    <servlet>
        <servlet-name>Home</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Home</servlet-name>
        <url-pattern></url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PortalChooser</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.PortalChooserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PortalChooser</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!--
        Four portals, four subclasses of AbstractLoginServlet. The superclass
        holds the whole authentication sequence; each subclass supplies only the
        role it admits and the view it renders (FR-OOP-11).
    -->
    <servlet>
        <servlet-name>PatientLogin</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.PatientLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientLogin</servlet-name>
        <url-pattern>/login/patient</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReceptionLogin</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.ReceptionLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceptionLogin</servlet-name>
        <url-pattern>/login/reception</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DentistLogin</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.DentistLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DentistLogin</servlet-name>
        <url-pattern>/login/dentist</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminLogin</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLogin</servlet-name>
        <url-pattern>/login/admin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Register</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Register</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Logout</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Logout</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  patients                                                    -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>PatientRecords</servlet-name>
        <servlet-class>com.sunrise.clinic.patients.web.PatientRecordsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientRecords</servlet-name>
        <url-pattern>/reception/patients</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  scheduling                                                  -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>AvailabilityPage</servlet-name>
        <servlet-class>com.sunrise.clinic.scheduling.web.AvailabilityPageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AvailabilityPage</servlet-name>
        <url-pattern>/reception/availability</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  appointments                                                -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!--  billing                                                     -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!--  reporting                                                   -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!--  feedback — complaints and reviews                           -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!--  JSON API                                                    -->
    <!--                                                              -->
    <!--  A prefix mapping /x/* claims every path beneath it, and      -->
    <!--  servlet mapping has no middle wildcard. That is why a review -->
    <!--  is /api/reviews/* rather than /api/appointments/*/review —   -->
    <!--  see docs/servlets.md §5.                                    -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>AuthApi</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.AuthApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthApi</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PatientApi</servlet-name>
        <servlet-class>com.sunrise.clinic.patients.web.PatientApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientApi</servlet-name>
        <url-pattern>/api/patients/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AvailabilityApi</servlet-name>
        <servlet-class>com.sunrise.clinic.scheduling.web.AvailabilityApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AvailabilityApi</servlet-name>
        <url-pattern>/api/availability/*</url-pattern>
    </servlet-mapping>
    <!-- Publishing a window and reading its slots are one feature, so one servlet. -->
    <servlet-mapping>
        <servlet-name>AvailabilityApi</servlet-name>
        <url-pattern>/api/sessions</url-pattern>
    </servlet-mapping>

    <!-- One servlet, two exact mappings: the same kind of small readable list. -->
    <servlet>
        <servlet-name>ReferenceApi</servlet-name>
        <servlet-class>com.sunrise.clinic.scheduling.web.ReferenceApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReferenceApi</servlet-name>
        <url-pattern>/api/dentists</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReferenceApi</servlet-name>
        <url-pattern>/api/treatments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AccountApi</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.AccountApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AccountApi</servlet-name>
        <url-pattern>/api/accounts</url-pattern>
    </servlet-mapping>

    <!--
        TEMPORARY - delete at step 4 (three of these) and step 7 (the fourth).

        The four role home paths, so sign-in has somewhere to go before the
        modules that own these screens are migrated. Without them HomeServlet
        would redirect a signed-in receptionist to /reception/home and Tomcat
        would answer 404.
    -->
    <servlet>
        <servlet-name>StubHome</servlet-name>
        <servlet-class>com.sunrise.clinic.access.web.StubHomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StubHome</servlet-name>
        <url-pattern>/patient/home</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StubHome</servlet-name>
        <url-pattern>/reception/home</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StubHome</servlet-name>
        <url-pattern>/dentist/schedule</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StubHome</servlet-name>
        <url-pattern>/admin/reports</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  Sessions and error pages                                    -->
    <!-- ============================================================ -->

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <!-- Not readable from JavaScript, which limits what a scripting
                 flaw could do with it (NFR-SEC-04). -->
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/shared/not-found.jsp</location>
    </error-page>
    <!-- Signed in, but the page belongs to another role. The filter forwards
         here directly; this mapping catches a servlet that sets 403 itself. -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/shared/forbidden.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/shared/error.jsp</location>
    </error-page>

</web-app>
