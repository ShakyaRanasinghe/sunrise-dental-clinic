@startuml seq_ai
' Sequence Diagram 4 - AI Dental Symptom Triage (grounding gate + mandatory disclaimer + fallback)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
  ArrowColor #2C6EBB
  LifeLineBorderColor #2C6EBB
  ParticipantBorderColor #2C6EBB
  ParticipantBackgroundColor #F4F9FF
  ActorBorderColor #2C6EBB
}
title Sequence 4 - AI Symptom Triage  (safe by construction: gate -> LLM -> mandatory disclaimer, deterministic fallback)

actor Patient as P
participant "React SPA\n(AI chat)" as R
participant "AiController" as C
participant "AiService" as S
participant "AiSettings\n<<runtime config>>" as CFG
participant "LlmProvider\n(GeminiProvider)" as LLM
database "Dental KB\n(knowledge pack)" as KB

P -> R : describe symptom ("sharp pain, cold sensitivity")
activate R
R -> C : POST /ai/triage { text }
activate C
C -> S : triage(text)
activate S

S -> S : safetyGate(text)  (block off-topic / unsafe)
S -> CFG : read current { provider, model, enabled }
activate CFG
CFG --> S : settings
deactivate CFG

alt AI disabled OR provider unavailable
    S -> KB : keyword -> urgency lookup (deterministic fallback)
    activate KB
    KB --> S : static guidance
    deactivate KB
    note right of S : tagged "not AI-generated"
else AI enabled
    S -> KB : ground(text)  (retrieve relevant dental facts)
    activate KB
    KB --> S : grounding context
    deactivate KB
    S -> LLM : generate(prompt + guardrails.json scope + grounding)
    activate LLM
    LLM --> S : draft guidance
    deactivate LLM
end

S -> S : ensureDisclaimer(response)  (idempotent - always append "This is not a diagnosis; see a licensed dentist")
S -> S : log provider, model, tokens, latency
S --> C : { guidance, suggestedTreatment, urgency, disclaimer }
deactivate S
C --> R : 200 triage result
deactivate C
R --> P : guidance + "Book an appointment" CTA
deactivate R
@enduml
