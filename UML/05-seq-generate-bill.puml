@startuml seq_bill
' Sequence Diagram 3 - Calculate & Print Bill (Strategy pricing + 3-way revenue split)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
  ArrowColor #2C6EBB
  LifeLineBorderColor #2C6EBB
  ParticipantBorderColor #2C6EBB
  ParticipantBackgroundColor #F4F9FF
  ActorBorderColor #2C6EBB
}
title Sequence 3 - Calculate &amp; Print Bill  (<<include>> Calculate Treatment Cost; Strategy + RevenueSplit)

actor Receptionist as RC
participant "React SPA" as R
participant "BillController" as C
participant "BillingService" as S
participant "BillingStrategy\n<<Strategy>>" as BS
participant "RevenueSplitStrategy\n<<Strategy>>" as RS
participant "PdfReceiptService" as PDF
database "Firestore\n(appointments, bills)" as DB

RC -> R : open COMPLETED appointment, click "Generate Bill"
activate R
R -> C : POST /appointments/{no}/bill
activate C
C -> S : generateBill(appointmentNo)
activate S
S -> DB : load Appointment + Treatment + Dentist
activate DB
DB --> S : appointment, treatment, dentist
deactivate DB

S -> BS : calculate(consultationFee, treatment.baseCost, serviceCharge)   <<include>>
activate BS
BS --> S : { total, consultationFee, treatmentCost, serviceCharge }
deactivate BS

S -> RS : split(bill)
activate RS
note right of RS : dentist = consultation + 0.60 x treatment\nclinic  = 0.40 x treatment\nreception = serviceCharge
RS --> S : { dentistEarning, clinicEarning, receptionistEarning }
deactivate RS

S -> DB : save Bill + set Appointment -> BILLED
activate DB
DB --> S : committed
deactivate DB

S -> PDF : render(bill)
activate PDF
PDF --> S : PDF bytes (receipt)
deactivate PDF

S --> C : bill + receiptUrl
deactivate S
C --> R : 201 { bill, receiptUrl }
deactivate C
R --> RC : printable receipt (download PDF)
deactivate R
@enduml
