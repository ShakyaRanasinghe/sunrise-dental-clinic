@startuml seq_book
' Sequence Diagram 2 - Book Appointment (atomic slot booking, Singleton id-gen, Observer notify)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
  ArrowColor #2C6EBB
  LifeLineBorderColor #2C6EBB
  ParticipantBorderColor #2C6EBB
  ParticipantBackgroundColor #F4F9FF
  ActorBorderColor #2C6EBB
}
title Sequence 2 - Book Appointment  (<<include>> Validate Details, Check Slot Availability; <<extend>> Send Confirmation)

actor Patient as P
participant "React SPA\n(booking wizard)" as R
participant "AppointmentController" as C
participant "AppointmentService" as S
participant "AppointmentNumberGenerator\n<<Singleton>>" as GEN
database "Firestore\n(slots, appointments,\ncounters)" as DB
participant "AppointmentEventPublisher\n<<Observer>>" as PUB
participant "EmailChannel\n<<Factory product>>" as MAIL

P -> R : choose open slot + treatment, confirm
activate R
R -> C : POST /appointments { slotId, treatmentId }
activate C
C -> C : validate request (Bean Validation)  <<include>>
C -> S : book(patientId, slotId, treatmentId)
activate S

group runTransaction  (atomic - prevents double booking)
    S -> DB : read slot(slotId)
    activate DB
    DB --> S : slot
    alt slot.status != OPEN   <<include>> Check Slot Availability
        S --> C : SlotAlreadyBookedException
        C --> R : 409 slot_taken
    else slot is OPEN
        S -> GEN : next()   (APT-YYYYMMDD-####)
        activate GEN
        GEN -> DB : increment counter(dayKey)
        DB --> GEN : seq
        GEN --> S : appointmentNo
        deactivate GEN
        S -> DB : write Appointment(CONFIRMED) + flip slot -> BOOKED
        DB --> S : committed
        deactivate DB
    end
end

S -> PUB : publish(AppointmentCreated)
activate PUB
PUB -> MAIL : send(confirmation)   <<extend>> Send Confirmation
activate MAIL
MAIL --> PUB : DispatchResult(sent)
deactivate MAIL
PUB -> DB : write Notification + AuditEvent
PUB --> S : done
deactivate PUB
S --> C : appointment
deactivate S
C --> R : 201 Created { appointmentNo }
deactivate C
R --> P : confirmation screen
deactivate R
@enduml
