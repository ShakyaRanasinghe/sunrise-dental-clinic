@startuml seq_login
' Sequence Diagram 1 - Login & Authenticate (with account-lockout extension)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
  ArrowColor #2C6EBB
  LifeLineBorderColor #2C6EBB
  ParticipantBorderColor #2C6EBB
  ParticipantBackgroundColor #F4F9FF
  ActorBorderColor #2C6EBB
}
title Sequence 1 - Login &amp; Authenticate  (<<include>> Authenticate, <<extend>> Lock Account)

actor "User\n(any role)" as U
participant "React SPA" as R
participant "Firebase\nAuthentication" as FB
participant "Spring Boot API\n(JwtAuthFilter)" as API
participant "LoginAttemptService" as LAS
database "Firestore\n(users)" as DB

U -> R : enter email + password
activate R
R -> FB : signInWithEmailAndPassword(email, pw)
activate FB

alt valid credentials
    FB --> R : ID token (JWT, role claim)
    deactivate FB
    R -> API : GET /auth/me  (Bearer ID token)
    activate API
    API -> FB : verifyIdToken(token)
    activate FB
    FB --> API : decoded claims (uid, role)
    deactivate FB
    API -> LAS : assertNotLocked(uid)
    activate LAS
    alt account locked
        LAS --> API : LockedException
        API --> R : 403 account_locked (retry-after)
    else not locked
        LAS --> API : ok
        deactivate LAS
        API -> DB : load user profile(uid)
        activate DB
        DB --> API : profile + role
        deactivate DB
        API --> R : 200 { profile, role }
    end
    deactivate API
    R -> R : route to role dashboard
    R --> U : dashboard for role
else wrong password  (<<extend>> Lock Account After Failed Attempts)
    FB --> R : auth error
    deactivate FB
    R -> API : POST /auth/failed-login (email)
    activate API
    API -> LAS : recordFailedLogin(uid)
    activate LAS
    note right of LAS : failedAttempts++\nif >= 5 -> locked = true,\nlockoutUntil = now + 24h
    LAS --> API : attempts, lockedUntil
    deactivate LAS
    API --> R : 401 invalid_credentials (attempts left)
    deactivate API
    R --> U : show error + attempts remaining
end
deactivate R
@enduml
