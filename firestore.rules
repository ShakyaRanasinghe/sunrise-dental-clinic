rules_version = '2';

// Defence-in-depth rules for direct client access. The Spring Boot backend uses the
// Firebase Admin SDK (which bypasses these rules); these protect the database if a
// client ever talks to Firestore directly. They mirror the application's RBAC +
// field-level access matrix.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userRole() { return request.auth.token.role; }
    function isAdmin() { return signedIn() && userRole() == 'ADMIN'; }
    function isStaff() { return signedIn() && userRole() in ['RECEPTIONIST', 'DENTIST', 'ADMIN']; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Patients: staff see all; a patient sees only their own record.
    match /patients/{id} {
      allow read:  if isStaff() || isSelf(resource.data.userUid);
      allow write: if isStaff();
    }

    // Appointments: staff see all; a patient sees only their own.
    match /appointments/{id} {
      allow read:  if isStaff() || isSelf(resource.data.patientId);
      allow write: if isStaff();
    }

    // Availability is readable by any signed-in user; only staff publish it.
    match /sessions/{id} { allow read: if signedIn(); allow write: if isStaff(); }
    match /slots/{id}    { allow read: if signedIn(); allow write: if isStaff(); }

    // Treatment catalogue: everyone reads, only admin edits.
    match /treatments/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Bills: staff see all; a patient sees only their own.
    match /bills/{id} {
      allow read:  if isStaff() || isSelf(resource.data.patientId);
      allow write: if isStaff();
    }

    // Audit trail: admin-read only; never client-writable (server writes it).
    match /auditEvents/{id} { allow read: if isAdmin(); allow write: if false; }

    // AI settings: readable by signed-in users, editable by admin only.
    match /clinics/{cid}/aiSettings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // Deny everything else by default.
    match /{document=**} { allow read, write: if false; }
  }
}
