<%--
    Shared page header: brand, role-appropriate navigation and the signed-in
    user. Included by every page so the navigation is defined once.

    Every value written out uses <c:out>, which escapes HTML. A patient whose
    name contained a tag would otherwise have it interpreted as markup — the
    classic stored cross-site scripting hole.
--%>
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="user" value="${requestScope.currentUser}" />
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${empty pageTitle ? 'Sunrise Dental Clinic' : pageTitle} — Sunrise Dental Clinic</title>
    <link rel="stylesheet" href="${ctx}/css/app.css">
</head>
<body>
<header class="site-header">
    <div class="bar">
        <a class="brand" href="${ctx}/">Sunrise <span>Dental</span></a>

        <nav class="site-nav">
            <c:choose>
                <c:when test="${user.role == 'PATIENT'}">
                    <a href="${ctx}/patient/home" class="${nav == 'home' ? 'active' : ''}">My appointments</a>
                    <a href="${ctx}/patient/book" class="${nav == 'book' ? 'active' : ''}">Book</a>
                </c:when>
                <c:when test="${user.role == 'RECEPTIONIST' or user.role == 'ADMIN'}">
                    <a href="${ctx}/reception/home" class="${nav == 'home' ? 'active' : ''}">Today</a>
                    <a href="${ctx}/patient/book" class="${nav == 'book' ? 'active' : ''}">Book</a>
                    <a href="${ctx}/reception/availability" class="${nav == 'availability' ? 'active' : ''}">Availability</a>
                    <a href="${ctx}/reception/patients" class="${nav == 'patients' ? 'active' : ''}">Patients</a>
                    <a href="${ctx}/reception/billing" class="${nav == 'billing' ? 'active' : ''}">Billing</a>
                    <c:if test="${user.role == 'ADMIN'}">
                        <a href="${ctx}/admin/reports" class="${nav == 'reports' ? 'active' : ''}">Reports</a>
                    </c:if>
                </c:when>
                <c:when test="${user.role == 'DENTIST'}">
                    <a href="${ctx}/dentist/schedule" class="${nav == 'schedule' ? 'active' : ''}">My schedule</a>
                </c:when>
            </c:choose>
            <a href="${ctx}/help" class="${nav == 'help' ? 'active' : ''}">Help</a>
        </nav>

        <c:if test="${not empty user}">
            <div class="who">
                <span><c:out value="${user.displayName}" /></span>
                <span class="role-tag">${user.role}</span>
                <a class="btn secondary small" href="${ctx}/logout">Sign out</a>
            </div>
        </c:if>
    </div>
</header>
<main>
